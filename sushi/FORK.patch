+    defer roots.deinit();
+    try roots.collect(slot.*);
+    try roots.collect(forward.cache.*);
+    try roots.collect(forward.ssm_entries);
+    try roots.collect(cps);
+    try collectHead(&roots, mc);
+    var protected: texas_priority.Roots = .{ .allocator = sch.allocator };
+    defer protected.deinit();
+    // Include private model buffers, not just public weights. The request's MTP
+    // state was swapped off the module before this protected-root traversal.
+    try protected.collect(xfm.*);
+    if (slot.model.weights) |w| {
+        var it = w.map.valueIterator();
+        while (it.next()) |a| try protected.collect(a.*);
+    }
+    if (slot.model.prefix_cache) |*hc| try protected.collect(hc.*);
+    if (slot.model.vision_encoder) |v| try protected.collect(v.*);
