+    texas_priority.nested = true;
+    defer texas_priority.nested = false;
+    while (true) {
+        texas_priority.set(.state, 2);
+        nativeStagePark(slot, forward);
+        var active_before: usize = 0;
+        _ = mlx.mlx_get_active_memory(&active_before);
+        var parked = texas_priority.Parked.create(&roots, &protected, slot.request_id);
+        _ = mlx.mlx_clear_cache();
+        var active_after: usize = 0;
+        _ = mlx.mlx_get_active_memory(&active_after);
+        texas_priority.set(.freed, active_before -| active_after);
+        texas_priority.set(.pauses, texas_priority.get(.pauses) + 1);
+        texas_priority.set(.state, 3);
+        texas_priority.drained();
+        while (true) {
+            texas_priority.set(.available, texas_priority.texas_available());
+            const held = nativeHeld(sch);
+            const ready = texas_priority.restoreFits(texas_priority.get(.available), texas_priority.get(.bytes));
+            texas_priority.set(.restore_wait, if (!ready) 1 else 0);
+            if ((!held or slot.cancelled.load(.acquire)) and ready) break;
+            texas_priority.drained();
+            if (sch.shutdown.load(.acquire)) std.process.exit(0);
+            _ = inferenceTick(sch, &nested_state);
+        }
+        texas_priority.set(.state, 4);
+        parked.restore();
+        texas_priority.set(.restore_wait, 0);
+        // Publish RUNNING before checking the gate: a new controller cannot
+        // acknowledge a drained background in the restore-to-dispatch race.
+        texas_priority.set(.state, 1);
+        if (!nativeHeld(sch) or slot.cancelled.load(.acquire)) break;
+    }
+    if (slot.cancelled.load(.acquire)) return error.Cancelled;
+    sleep_inhibit.setActive(true);
+}
