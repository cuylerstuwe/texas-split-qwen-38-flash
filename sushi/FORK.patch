+fn nativeBoundary(sch: *Scheduler, slot: *Slot, forward: *ForwardCtx, mc: ?*generate_mod.MtpCacheRef, cps: []const transformer_mod.SSMCheckpoint) !void {
+    if (!texas_priority.enabled() or !slot.background or texas_priority.nested) return;
+    texas_priority.set(.state, 1);
+    texas_priority.set(.tokens, slot.completion_tokens);
+    texas_priority.set(.prompt, slot.full_prompt.len);
+    texas_priority.set(.phase, if (slot.legacy_gen == null) 1 else 2);
+    if (slot.cancelled.load(.acquire)) return error.Cancelled;
+    if (!nativeHeld(sch)) return;
+    // texas-split: never park with a stage prefill chunk in flight (the prefill loop lands it first
+    // when the hook wants to park; a hold that arrived since then waits for the next boundary)
+    if (qwen4_forward.stagePrefillInflight() > 0) return;
+    const xfm = slot.model.transformer orelse return error.ModelNotReady;
+    const round_cost_saved = xfm.round_cost;
+    const group_cost_saved = xfm.mtp_group_cost;
+    const rng = texas_priority.texas_rng_save();
+    defer texas_priority.texas_rng_restore(rng);
+    defer {
+        xfm.round_cost = round_cost_saved;
+        xfm.mtp_group_cost = group_cost_saved;
+        if (mc) |m| m.activate();
+        if (slot.legacy_gen) |*g| {
+            g.invalidateSerialClock();
+            g.invalidateRoundClock();
+            g.stall = .{};
+        }
+    }
+    try xfm.ssmGroupRelease(forward);
+    releaseHead(mc);
