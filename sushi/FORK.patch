+/// Copy Sushi's committed state of layers [first, 48) into the stage (after a prefill).
+fn stageSeed(self: *Transformer, ctx: *ForwardCtx, first: usize, position: usize) !void {
+    // R60 S4: nothing cached yet (a cold prefill): the empty state, without reading Sushi's caches.
+    if (position == 0) {
+        if (stage_split_seed_zero() != 0) return error.StageSplitSeed;
