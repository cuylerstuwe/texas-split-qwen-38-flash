+/// texas-split: park the background sequence's stage half (layers [first, 48) on the RTX 5090) to
+/// SSD beside Sushi's own park; its next stage call restores it. A stage that fails here is given
+/// up, and the request re-runs Mac-only from its tokens when it resumes.
+fn nativeStagePark(slot: *Slot, forward: *ForwardCtx) void {
+    const dir = std.c.getenv("TEXAS_PRIORITY_CHECKPOINTS") orelse return;
+    const xfm = slot.model.transformer orelse return;
+    const position = qwen4_forward.stageCommittedPosition(xfm, forward) orelse return;
+    var buf: [1024]u8 = undefined;
+    const p = std.fmt.bufPrint(buf[0 .. buf.len - 1], "{s}/stage-request-{d}.bin", .{ std.mem.sliceTo(dir, 0), slot.request_id }) catch return;
+    buf[p.len] = 0;
+    if (qwen4_forward.stageSplitPark(forward, position, buf[0..p.len :0]) < 0)
+        log.warn("[stage] park failed at {d}; the request re-runs on the Mac when it resumes\n", .{position});
+}
