+fn nativeHeld(sch: *Scheduler) bool {
+    if (texas_priority.held()) return true;
+    sch.queue_mu.lockUncancelable(sch.io);
+    defer sch.queue_mu.unlock(sch.io);
+    for ([_][]*Slot{ sch.pending.items, sch.prefilling.items, sch.decoding.items }) |slots| {
+        for (slots) |s| if (!s.background and !s.finished and s.error_code == null and !s.cancelled.load(.acquire)) return true;
+    }
+    return sch.vision_queue.items.len > 0 or sch.embed_queue.items.len > 0;
