+/// Sushi's caches (canon-stage-server's "QDX1" blob: recurrent conv/state; attention KV rows through
+/// KVCache.appendQuantized, pooled blocks and raw keys through the QSA ring/bank helpers).
+pub fn stagePrefillImport(self: *Transformer, ctx: *ForwardCtx) !void {
+    var ptr: [*]const u8 = undefined;
+    var len: u64 = 0;
+    if (stage_split_prefill_export(&ptr, &len) != 0) return error.StageSplitPullback;
+    try importQdx1(self, ctx.cache, ctx.ssm_entries orelse return error.StageSplitNoSsm, ptr[0..@intCast(len)]);
