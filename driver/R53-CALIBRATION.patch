+// R53 project-local calibration, outside capture only. While a token is recorded, every descriptor also releases its
+// completion clock into va + 16 * index (payload index + 1, index < slots), and every replay writes chain k's
+// front-end clock as it reaches that chain's head launch into va + 16 * (slots + k). The caller owns the region
+// (16 * (slots + 128) bytes). Sealed recordings keep what they were recorded with; va 0 turns it off.
+tinynv_status_t tinynv_r53_stamp(tinynv_stream_t s, uint64_t va, uint32_t slots) {
+  if (!ON_GPU(s)) return TINYNV_ERR_UNSUPPORTED;
+  NEED_GPU(s);
+  if (va && (!slots || slots > 4096 || (va & 15))) return TINYNV_ERR_INVALID;
+  tinynv_exec_t *ex = &s->dev->exec;
+  return WITH_LOCK(ex->rec ? TINYNV_ERR_INVALID : (ex->r53_va = va, ex->r53_slots = va ? slots : 0, TINYNV_OK));
+}
