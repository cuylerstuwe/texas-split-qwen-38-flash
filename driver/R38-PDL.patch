+int tinynv_qmd_r38_pdl(tinynv_qmd_t *prev, tinynv_qmd_t *next, uint32_t latch, int mode) {
+  if (prev->v3 || next->v3) return tinynv_fail("the R38 early-launch experiment uses Blackwell (QMD V05) fields only");
+#define R38_SET(q, f, v) do { if (tinynv_qmd_set((q), TINYNV_QMD_##f##_LO, TINYNV_QMD_##f##_HI, (v))) return -1; } while (0)
+  if (mode & 1) R38_SET(prev, PRE_EXIT_AT_LAST_CTA_LAUNCH, 1);
+  if (mode & 2) R38_SET(prev, ENABLE_PROGRAM_PRE_EXIT, 1);
+  if (mode & 4) {
+    R38_SET(prev, ARRIVE_AT_LATCH_ID, latch);
+    R38_SET(prev, ARRIVE_AT_LATCH_VALID, 1);
+    R38_SET(next, WAIT_ON_LATCH_ID, latch);
+    R38_SET(next, WAIT_ON_LATCH_VALID, 1);
+    R38_SET(next, LATCH_ACQUIRE_INVALIDATE_SHADER_DATA_CACHE, 1);
+    R38_SET(next, LATCH_ACQUIRE_INVALIDATE_TEXTURE_DATA_CACHE, 1);
+  }
+  if (mode & 8) R38_SET(next, HOLD_CTA_LAUNCH_UNTIL_PARENT_LATCH_ACQUIRE_AND_CTA_COMPLETE, 1);
+  if (mode & 16) R38_SET(next, HOLD_MEMBAR_UNTIL_LATCH_ACQUIRE, 1);
+#undef R38_SET
+  return 0;
+}
