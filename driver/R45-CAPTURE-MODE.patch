+// R45 project-local capture control. Only descriptor construction reads this
+// mode; sealed graphs retain their own immutable dependency fields. This lets
+// one owner interleave serial and skip-edge controls without another client.
+tinynv_status_t tinynv_r45_capture_mode(tinynv_stream_t s, int mode) {
+  if (!ON_GPU(s)) return TINYNV_ERR_UNSUPPORTED;
+  NEED_GPU(s);
+  if (mode != 0 && mode != 64) return TINYNV_ERR_INVALID;
+  tinynv_exec_t *ex = &s->dev->exec;
+  return WITH_LOCK(ex->rec ? TINYNV_ERR_INVALID : (ex->pdl_mode = mode, TINYNV_OK));
+}
