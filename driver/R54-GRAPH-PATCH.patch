+int tinynv_exec_graph_patch(tinynv_exec_t *ex, tinynv_graph_rec_t *r, uint32_t launch, uint32_t offset,
+                            const void *data, uint32_t len) {
+  (void)ex;
+  if (!r || !r->sealed) return tinynv_fail("R54 patch: that recording was never sealed");
+  if (launch >= r->n || !r->param_off) return tinynv_fail("R54 patch: launch %u of %u", launch, r->n);
+  if (!len || len > 16 || (len & 3u) || (offset & 3u) || offset + len > r->param_len[launch])
+    return tinynv_fail("R54 patch: %u bytes at %u of a %u-byte parameter block", len, offset, r->param_len[launch]);
+  if (r->npatch >= 1024) return tinynv_fail("R54 patch: more than 1024 queued before a replay");
+  if (r->npatch >= r->patch_cap) {
+    uint32_t cap = r->patch_cap ? 2u * r->patch_cap : 64u;
+    void *p = realloc(r->patch, cap * sizeof(*r->patch));
+    if (!p) return tinynv_fail("R54 patch: out of memory");
+    r->patch = p; r->patch_cap = cap;
+  }
+  uint64_t region = (uint64_t)r->param_off[launch] + offset;
+  r->patch[r->npatch].va = r->mem.va + region;
+  r->patch[r->npatch].len = len;
+  memcpy(r->patch[r->npatch].w, data, len);
+  memcpy((uint8_t *)r->mirror.dma.va + region, data, len);   // the host copy stays what the engine will read
+  r->npatch++;
+  return 0;
+}
