+// R54 project-local: rewrite len (4, 8, 12 or 16) bytes at byte `offset` of recorded launch `launch`'s parameters;
+// applied by the next replay before any of its launches, and kept for later replays.
+tinynv_status_t tinynv_r54_graph_patch(tinynv_stream_t s, tinynv_graph_t g, uint32_t launch, uint32_t offset,
+                                       const void *data, uint32_t len) {
+  if (!ON_GPU(s) || !g || !data) return TINYNV_ERR_INVALID;
+  NEED_GPU(s);
+  return WITH_LOCK(tinynv_exec_graph_patch(&s->dev->exec, (tinynv_graph_rec_t *)g, launch, offset, data, len))
+             ? TINYNV_ERR_INVALID : TINYNV_OK;
+}
