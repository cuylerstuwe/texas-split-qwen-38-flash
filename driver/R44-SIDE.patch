diff --git a/driver-r38/libtinynv/src/qmd.c b/driver-r38/libtinynv/src/qmd.c
index 29ad4e9..2e93053 100644
--- a/driver-r38/libtinynv/src/qmd.c
+++ b/driver-r38/libtinynv/src/qmd.c
@@ -399,3 +399,18 @@ int tinynv_qmd_r38_pdl(tinynv_qmd_t *prev, tinynv_qmd_t *next, uint32_t latch, i
 #undef R38_SET
   return 0;
 }
+
+int tinynv_qmd_r44_edge(tinynv_qmd_t *prev, tinynv_qmd_t *next,
+                       uint32_t arrive, uint32_t wait, int early) {
+  if (prev->v3 || next->v3) return tinynv_fail("R44 requires Blackwell QMD V05");
+#define R44_SET(q,f,v) do { if (tinynv_qmd_set((q),TINYNV_QMD_##f##_LO,TINYNV_QMD_##f##_HI,(v))) return -1; } while (0)
+  if (early) R44_SET(prev,PRE_EXIT_AT_LAST_CTA_LAUNCH,1);
+  R44_SET(prev,ARRIVE_AT_LATCH_ID,arrive);
+  R44_SET(prev,ARRIVE_AT_LATCH_VALID,1);
+  R44_SET(next,WAIT_ON_LATCH_ID,wait);
+  R44_SET(next,WAIT_ON_LATCH_VALID,1);
+  R44_SET(next,LATCH_ACQUIRE_INVALIDATE_SHADER_DATA_CACHE,1);
+  R44_SET(next,LATCH_ACQUIRE_INVALIDATE_TEXTURE_DATA_CACHE,1);
+#undef R44_SET
+  return 0;
+}
